# Generated QManager work trees and fetch caches
qmanager/qmanager_work*/
qmanager/.casa_fetch/

# Build outputs and dependencies
qmanager-build/
node_modules/
out/
.next/
*.tar.gz
*.ipk
bun.lockb

# Secrets and local machine state
.env
.env.*
*.key
*.pem
*.pub
.ssh/

# Claude Code runtime/local files (never commit)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Selective video helper is built and checked in CI, not committed as a binary.
qmanager/casa_conversion/vendor/scripts/usr/bin/qmanager_video_selective
__pycache__/
!qmanager/casa_conversion/vendor/entware-fallback/*.ipk
